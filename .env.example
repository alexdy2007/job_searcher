# Copy to .env and fill in. .env is gitignored.

# Host port 5433 avoids clashing with any Postgres already on 5432.
DATABASE_URL=postgresql+psycopg://job_searcher:job_searcher@localhost:5433/job_searcher

ANTHROPIC_API_KEY=

# Model used for HTML extraction and description enrichment.
EXTRACTION_MODEL=claude-opus-5

# Sent on every outbound request so site owners can identify and contact us.
USER_AGENT=job-searcher/0.1 (+https://github.com/yourname/job-searcher)

# Max sources fetched concurrently across a run.
MAX_CONCURRENCY=8

# Max concurrent requests to any single domain.
PER_DOMAIN_CONCURRENCY=2

# Hard stop for a single scrape run, in USD. 0 disables the ceiling.
RUN_COST_BUDGET_USD=5.0

# Raw page cache. Defaults to <project>/.cache when unset.
# CACHE_DIR=
